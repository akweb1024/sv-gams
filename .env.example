# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# Required: set a long random string (at least 32 chars)
JWT_SECRET=replace_with_a_long_random_secret

# Postgres connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
DATABASE_URL=postgresql://postgres:replace_with_strong_password@postgres:5432/game?schema=public

# Optional: comma-separated allowed origins.
# Leave empty to allow all origins.
# CORS_ORIGIN=https://game.example.com

# Startup controls (Coolify env vars)
RUN_MIGRATIONS=true
RUN_SEED=false

# Optional Prisma logs
PRISMA_LOG_INFO=false
PRISMA_LOG_QUERIES=false

# Optional: comma-separated admin usernames for privileged maintenance endpoints.
# Example: ADMIN_USERNAMES=admin,ops_lead
ADMIN_USERNAMES=amit
