# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# Required: set a long random string (at least 32 chars)
JWT_SECRET=replace_with_a_long_random_secret

# SQLite file path inside container (persist /app/data in Coolify)
DATABASE_URL=file:/app/data/game.db

# Optional: comma-separated allowed origins.
# Leave empty to allow all origins.
# CORS_ORIGIN=https://game.example.com

# Startup controls (Coolify env vars)
RUN_MIGRATIONS=true
RUN_SEED=false

# Optional Prisma logs
PRISMA_LOG_INFO=false
PRISMA_LOG_QUERIES=false
